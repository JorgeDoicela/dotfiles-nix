# === CONFIGURACIÓN DE TECLAS PROFESIONAL PARA LAPTOP ===
# Evita el uso de teclas de función (F1-F12) que requieren presionar Fn.

# Alternar color personalizado (Catppuccin/Tema actual) con la tecla 'd'
toggle_custom_color d

# Navegación rápida de lectura (Espacio = avanzar salto / Borrar o Shift+Espacio = retroceder salto)
screen_down <space>
screen_up <S-<space>>
screen_up <backspace>

# Pantalla completa + Ocultar/Mostrar barra de estado con Alt + Enter o Alt + f
toggle_fullscreen;toggle_statusbar <A-Enter>
toggle_fullscreen;toggle_statusbar <A-f>

# Ajustar ancho de página de forma inteligente (Smart fit to width) con 'w'
# (Nota: El ajuste normal de ancho sigue estando por defecto en '=')
fit_to_page_width_smart w

# Alternar resaltado de enlaces en el PDF con Alt + h (Highlight)
toggle_highlight <A-h>

# Alternar modo oscuro invertido con Alt + d (Dark mode)
toggle_dark_mode <A-d>

# Alternar modo presentación con Alt + p (Presentation)
toggle_presentation_mode <A-p>

# Alternar modo de arrastre con mouse con Alt + m (Mouse drag)
toggle_mouse_drag_mode <A-m>

# Alternar scroll visual con Alt + v (Visual scroll)
toggle_visual_scroll <A-v>

# Alternar ventana de configuración del helper (Portales, etc.) con Alt + c (Config)
toggle_window_configuration <A-c>

# Alternar SyncTeX (para LaTeX) con Alt + s (Synctex)
toggle_synctex <A-s>
