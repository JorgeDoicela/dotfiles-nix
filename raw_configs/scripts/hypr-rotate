#!/usr/bin/env bash
set -euo pipefail

# Script: hypr-rotate
# Descripción: Cambia dinámicamente la orientación de la pantalla en Hyprland respetando la escala y el nombre del monitor.
# Uso: hypr-rotate {normal|left|right|inverted|toggle}

command -v hyprctl >/dev/null 2>&1 || { echo "Error: hyprctl no está instalado" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "Error: jq no está instalado" >&2; exit 1; }

# Obtener los datos del primer monitor activo (pantalla interna de laptop)
MONITOR_JSON=$(hyprctl monitors -j | jq -r '.[0] // empty')

if [ -z "$MONITOR_JSON" ]; then
    echo "Error: No se encontró ningún monitor activo." >&2
    exit 1
fi

MONITOR_NAME=$(echo "$MONITOR_JSON" | jq -r '.name')
CURRENT_SCALE=$(echo "$MONITOR_JSON" | jq -r '.scale // 1')
CURRENT_TRANSFORM=$(echo "$MONITOR_JSON" | jq -r '.transform // 0')

TARGET_TRANSFORM=0
ORIENTATION_LABEL="Horizontal (0°)"

case "${1:-toggle}" in
    normal|0)
        TARGET_TRANSFORM=0
        ORIENTATION_LABEL="Horizontal (0°)"
        ;;
    left|90|1)
        TARGET_TRANSFORM=1
        ORIENTATION_LABEL="Vertical Izquierda (90°)"
        ;;
    inverted|180|2)
        TARGET_TRANSFORM=2
        ORIENTATION_LABEL="Invertida (180°)"
        ;;
    right|270|3)
        TARGET_TRANSFORM=3
        ORIENTATION_LABEL="Vertical Derecha (270°)"
        ;;
    toggle)
        if [ "$CURRENT_TRANSFORM" -eq 0 ]; then
            TARGET_TRANSFORM=1
            ORIENTATION_LABEL="Vertical Izquierda (90°)"
        elif [ "$CURRENT_TRANSFORM" -eq 1 ]; then
            TARGET_TRANSFORM=3
            ORIENTATION_LABEL="Vertical Derecha (270°)"
        else
            TARGET_TRANSFORM=0
            ORIENTATION_LABEL="Horizontal (0°)"
        fi
        ;;
    *)
        echo "Uso: $0 {normal|left|right|inverted|toggle}" >&2
        exit 1
        ;;
esac

# Aplicar rotación dinámicamente manteniendo la escala del monitor
hyprctl keyword monitor "${MONITOR_NAME},preferred,auto,${CURRENT_SCALE},transform,${TARGET_TRANSFORM}"

# Enviar notificación de estado si notify-send está disponible
if command -v notify-send >/dev/null 2>&1; then
    notify-send "Orientación de Pantalla" "$ORIENTATION_LABEL" -i display-symbolic -t 2000 -h string:x-canonical-private-synchronous:screen-orientation
fi
