#!/usr/bin/env bash
# Script de integración Flameshot para Hyprland (Wayland)
# Causa raíz del error: Flameshot no tiene backend para 'Hyprland', requiere 'sway' para activar el motor wlroots/grim.

export XDG_CURRENT_DESKTOP=sway
export QT_QPA_PLATFORM=wayland
export QT_AUTO_SCREEN_SCALE_FACTOR=1

pkill -9 -x flameshot 2>/dev/null
exec flameshot "$@"

