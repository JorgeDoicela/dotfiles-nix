#!/usr/bin/env python3
"""
Sioyek Robust Launcher & State Synchronizer (dotfiles-nix)
=========================================================
Garantiza ejecución estable y previene fallos de segmentación (SIGSEGV / exit code 139)
en Sioyek 2.0.0 causados por estados huérfanos en SQLite (~/.local/share/sioyek/).

Causa Raíz Atendida:
--------------------
En Sioyek 2.0.0, cuando un documento modificado o con estructura dinámica conserva
registros previos en 'document_hash' (local.db) u 'opened_books' (shared.db), el motor
intenta restaurar coordenadas y estructuras de navegación desfasadas. Si el vector
interno está desincronizado, una resta aritmética no signada (size - 1) desborda a 2^64-1,
produciendo una desreferenciación a puntero nulo (SIGSEGV).

Estrategia Profesional:
-----------------------
1. Pre-check: Invalida preventivamente registros de caché en local.db y shared.db para los
   archivos que hayan cambiado en disco o pertenezcan a rutas de compilación/descarga.
2. Invocación limpia: Si el proceso arranca normalmente (99.9% de los casos), cede el control.
3. Resiliencia activa: Si Sioyek retornara código 139 (crashed), purga de inmediato el registro
   del archivo en shared.db y lo relanza limpio de forma transparente.
"""
import os
import sys
import sqlite3
import hashlib
import subprocess
import shutil

SIOYEK_BIN = "/usr/bin/sioyek"
if not os.path.isfile(SIOYEK_BIN):
    SIOYEK_BIN = shutil.which("sioyek") or "/usr/bin/sioyek"


def purge_db_records(file_paths):
    local_db = os.path.expanduser("~/.local/share/sioyek/local.db")
    shared_db = os.path.expanduser("~/.local/share/sioyek/shared.db")

    for raw in file_paths:
        abs_path = os.path.abspath(os.path.expanduser(raw))
        real_path = os.path.realpath(abs_path)
        candidates = {abs_path, real_path}

        hashes_to_purge = set()

        if os.path.isfile(local_db):
            try:
                with sqlite3.connect(local_db, timeout=0.5) as conn:
                    cur = conn.cursor()
                    for c in candidates:
                        rows = cur.execute("SELECT hash FROM document_hash WHERE path = ?", (c,)).fetchall()
                        for r in rows:
                            hashes_to_purge.add(r[0])
                        cur.execute("DELETE FROM document_hash WHERE path = ?", (c,))
                    conn.commit()
            except Exception:
                pass

        if os.path.isfile(shared_db) and hashes_to_purge:
            try:
                with sqlite3.connect(shared_db, timeout=0.5) as conn:
                    cur = conn.cursor()
                    for h in hashes_to_purge:
                        cur.execute("DELETE FROM opened_books WHERE path = ?", (h,))
                    conn.commit()
            except Exception:
                pass


def sanitize_on_change(file_paths):
    local_db = os.path.expanduser("~/.local/share/sioyek/local.db")
    shared_db = os.path.expanduser("~/.local/share/sioyek/shared.db")
    if not (os.path.isfile(local_db) and os.path.isfile(shared_db)):
        return

    to_purge = []
    for raw in file_paths:
        abs_path = os.path.abspath(os.path.expanduser(raw))
        real_path = os.path.realpath(abs_path)
        target = real_path if os.path.isfile(real_path) else abs_path

        if not (os.path.isfile(target) and target.lower().endswith(".pdf")):
            continue

        # En Descargas, Proyectos o tmp, los PDFs cambian frecuentemente de longitud o páginas
        if "/Descargas" in target or "/Proyectos/" in target or "/tmp" in target:
            to_purge.append(target)
            continue

        # Para libros y lecturas estáticas, comparar hash MD5
        try:
            with sqlite3.connect(local_db, timeout=0.5) as conn:
                cur = conn.cursor()
                row = cur.execute(
                    "SELECT hash FROM document_hash WHERE path IN (?, ?)",
                    (abs_path, real_path),
                ).fetchone()
                if row:
                    cached = row[0]
                    with open(target, "rb") as f:
                        current_md5 = hashlib.md5(f.read()).hexdigest()
                    if current_md5 != cached:
                        to_purge.append(target)
        except Exception:
            pass

    if to_purge:
        purge_db_records(to_purge)


def main():
    target_files = [arg for arg in sys.argv[1:] if not arg.startswith("-")]

    if target_files:
        sanitize_on_change(target_files)

    try:
        res = subprocess.run([SIOYEK_BIN] + sys.argv[1:])
        if res.returncode in (139, -11):
            if target_files:
                purge_db_records(target_files)
            os.execv(SIOYEK_BIN, [SIOYEK_BIN] + sys.argv[1:])
        sys.exit(res.returncode)
    except Exception:
        os.execv(SIOYEK_BIN, [SIOYEK_BIN] + sys.argv[1:])


if __name__ == "__main__":
    main()
