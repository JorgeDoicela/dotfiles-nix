# ==============================================================================
# CONFIGURACIÓN DECLARATIVA DE TUMBLER (DAEMON DE MINIATURAS XFCE / DESKTOP)
# ==============================================================================
# Excluye formalmente montajes virtuales de red/FUSE (~/Drive) y cachés para
# evitar saturación de D-Bus, rate limiting de APIs y congelamientos de interfaz.

[JPEGThumbnailer]
Disabled=false
Priority=3
Locations=
Excludes=~/Drive;~/.cache;
MaxFileSize=52428800

[RawThumbnailer]
Disabled=false
Priority=3
Locations=
Excludes=~/Drive;~/.cache;
MaxFileSize=52428800

[PixbufThumbnailer]
Disabled=false
Priority=2
Locations=
Excludes=~/Drive;~/.cache;
MaxFileSize=52428800

[CoverThumbnailer]
Disabled=true
Priority=3
Locations=~/movies
Excludes=~/Drive;
MaxFileSize=0

[FfmpegThumbnailer]
Disabled=false
Priority=2
Locations=
Excludes=~/Drive;~/.cache;
MaxFileSize=52428800

[GstThumbnailer]
