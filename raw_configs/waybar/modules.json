{
    "hyprland/workspaces": {
        "disable-scroll": true,
        "format": "{name}",
        "on-click": "activate"
    },
    "hyprland/window": {
        "format": "󰉋 {title}",
        "max-length": 30,
        "separate-outputs": true
    },
    "clock": {
        "interval": 30,
        "format": "{:%a %d %b  %H:%M}",
        "tooltip": false,
        "on-click": "gsimplecal"
    },
    "clock#compact": {
        "interval": 30,
        "format": "{:%H:%M}",
        "tooltip": false,
        "on-click": "gsimplecal"
    },
    "cpu": {
        "interval": 5,
        "format": "󰻠 {usage}%",
        "on-click": "alacritty -e btop",
        "tooltip": false
    },
    "memory": {
        "interval": 5,
        "format": "󰍛 {percentage}%",
        "on-click": "alacritty -e btop",
        "tooltip": true,
        "tooltip-format": "RAM utilizada: {used:0.1f}G / {total:0.1f}G"
    },
    "disk": {
        "interval": 60,
        "format": "󰋊 {percentage_used}%",
        "on-click": "alacritty -e btop",
        "path": "/"
    },
    "mpris": {
        "format": "󰎈 {title}",
        "format-paused": "󰏤 <i>{title}</i>",
        "max-length": 36,
        "tooltip": true,
        "tooltip-format": "{artist} - {album}"
    },
    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname} 󰈀",
        "tooltip-format-disconnected": "Desconectado",
        "on-click": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "󰂯 Listo",
        "format-connected": "󰂱 {device_alias}",
        "format-disabled": "󰂲 Apagado",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰁹"],
        "tooltip": true,
        "tooltip-format": "{timeTo}, {capacity}%\nConsumo: {power}W",
        "tooltip-format-charging": "Cargando: {timeTo} ({capacity}%)\nPotencia: {power}W",
        "on-click": "swaync-client -t"
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t",
        "on-click-right": "swaync-client -d",
        "escape": true
    },
    "custom/launcher": {
        "format": "",
        "on-click": "pkill -x rofi 2>/dev/null; rofi -show drun",
        "tooltip": "Menú de Aplicaciones"
    },
    "custom/session": {
        "format": "󰐥",
        "on-click": "~/.config/hypr/scripts/logoutlaunch.sh",
        "tooltip": "Menú de Apagado / Sesión"
    }
}
