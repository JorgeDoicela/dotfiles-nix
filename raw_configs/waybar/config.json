{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "custom/layout",
        "hyprland/window"
    ],
    "modules-center": [
        "cpu",
        "memory",
        "disk",
        "mpris"
    ],
    "modules-right": [
        "custom/keybinds",
        "custom/screenshot",
        "custom/audio",
        "custom/theme",
        "custom/wallpaper",
        "custom/emoji",
        "custom/terminal",
        "custom/files",
        "custom/clipboard",
        "custom/look",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery",
        "custom/notification",
        "clock",
        "custom/lock",
        "custom/session"
    ],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },
    "custom/layout": {
        "exec": "hyprctl getoption general:layout | awk '/str:/{print $2}' | sed 's/dwindle/󰖲/;s/master/󰓩/'",
        "interval": 2,
        "on-click": "cur=$(hyprctl getoption general:layout 2>/dev/null | awk '{print $2}'); hyprctl keyword general:layout $([ \"$cur\" = \"dwindle\" ] && echo master || echo dwindle)",
        "tooltip": "Alternar Layout (dwindle/master)"
    },
    "hyprland/window": {
        "format": "󰉋 {title}",
        "max-length": 30,
        "separate-outputs": true
    },
    "cpu": {
        "interval": 2,
        "format": "󰻠 {usage}%",
        "on-click": "alacritty -e btop",
        "tooltip": false
    },
    "memory": {
        "interval": 2,
        "format": "󰍛 {percentage}%",
        "on-click": "alacritty -e btop",
        "tooltip": true,
        "tooltip-format": "RAM utilizada: {used:0.1f}G / {total:0.1f}G"
    },
    "disk": {
        "interval": 30,
        "format": "󰋊 {percentage_used}%",
        "on-click": "alacritty -e btop",
        "path": "/"
    },
    "mpris": {
        "format": "󰎈 {title}",
        "format-paused": "󰏤 <i>{title}</i>",
        "max-length": 36,
        "tooltip": true,
        "tooltip-format": "{artist} - {album}"
    },
    "clock": {
        "interval": 1,
        "format": "{:%a %d %b  %H:%M:%S}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#eccbf3'><b>{}</b></span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "on-click": "gsimplecal"
    },
    "network": {
        "format": "󰤨",
        "format-wifi": "󰤨 {ssid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format": "{ifname} vía {gwaddr}",
        "tooltip-format-wifi": "{ssid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Desconectado",
        "on-click": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "󰂯 Listo",
        "format-connected": "󰂱 {device_alias}",
        "format-disabled": "󰂲 Apagado",
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰁹"],
        "on-click": "xfce4-power-manager-settings"
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t",
        "on-click-right": "swaync-client -d",
        "escape": true
    },
    "custom/launcher": {
        "format": "",
        "on-click": "pkill -x rofi 2>/dev/null; rofi -show drun",
        "tooltip": "Menú de Aplicaciones"
    },
    "custom/keybinds": {
        "format": "󰘥",
        "on-click": "pkill -x rofi 2>/dev/null; ~/.config/hypr/scripts/keybinds_hint.sh c",
        "tooltip": "Atajos"
    },
    "custom/screenshot": {
        "format": "󰈙",
        "on-click": "~/.local/bin/flameshot-hypr gui",
        "tooltip": "Captura"
    },
    "custom/audio": {
        "format": "󰝳",
        "on-click": "pavucontrol",
        "tooltip": "Control de Audio"
    },
    "custom/theme": {
        "format": "󰉼",
        "on-click": "notify-send 'Apariencia' 'Tu tema actual está configurado de forma estática en ~/.config/' -i dialog-information",
        "tooltip": "Tema"
    },
    "custom/wallpaper": {
        "format": "󰆼",
        "on-click": "~/.config/hypr/scripts/change_wallpaper.sh",
        "tooltip": "Cambiar Fondo de Pantalla"
    },
    "custom/emoji": {
        "format": "󰀻",
        "on-click": "pkill -x rofi 2>/dev/null; ~/.config/hypr/scripts/emoji-picker.sh",
        "tooltip": "Emojis"
    },
    "custom/terminal": {
        "format": "󰆍",
        "on-click": "alacritty",
        "tooltip": "Terminal"
    },
    "custom/files": {
        "format": "󰝰",
        "on-click": "thunar",
        "tooltip": "Archivos"
    },
    "custom/clipboard": {
        "format": "󰋊",
        "on-click": "pkill -x rofi 2>/dev/null; ~/.config/hypr/scripts/cliphist-rofi.sh",
        "tooltip": "Portapapeles"
    },
    "custom/look": {
        "format": "󰖪",
        "on-click": "nwg-look",
        "tooltip": "Apariencia"
    },
    "custom/lock": {
        "format": "󰌾",
        "on-click": "hyprlock",
        "tooltip": "Bloquear"
    },
    "custom/session": {
        "format": "󰐥",
        "on-click": "~/.config/hypr/scripts/logoutlaunch.sh",
        "tooltip": "Sesión"
    }
}
