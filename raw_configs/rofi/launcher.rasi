/**
 * Rofi Configuration — Fullscreen ChromeOS / Launchpad Grid Style
 * Usado exclusivamente para el lanzador de aplicaciones (Super + Espacio).
 */

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    display-drun:               " ";
    display-run:                " ";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 11";
}

@theme "~/.config/rofi/theme.rasi"

window {
    transparency:                "real";
    fullscreen:                  true;
    enabled:                     true;
    cursor:                      "default";
    background-color:            @main-bg;
    padding:                     0px;
    margin:                      0px;
    border:                      0px;
}

mainbox {
    enabled:                     true;
    spacing:                     40px;
    margin:                      0px;
    padding:                     60px 120px 40px 120px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     12px;
    margin:                      0px calc( 50% - 275px );
    padding:                     12px 24px;
    border:                      1px;
    border-color:                @main-br;
    border-radius:               999px;
    background-color:            @main-ex;
    text-color:                  @main-fg;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    font:                        "JetBrainsMono Nerd Font 13";
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      "text";
    placeholder:                 "Buscar aplicaciones...";
    placeholder-color:           rgba(245, 245, 247, 0.4);
    font:                        "JetBrainsMono Nerd Font 11";
}

listview {
    enabled:                     true;
    columns:                     6;
    lines:                       4;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;
    spacing:                     20px;
    margin:                      0px;
    padding:                     20px 0px;
    background-color:            transparent;
    text-color:                  @main-fg;
    cursor:                      "default";
}

element {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     12px;
    margin:                      0px;
    padding:                     20px 10px;
    border:                      1px;
    border-color:                transparent;
    border-radius:               18px;
    background-color:            transparent;
    text-color:                  @main-fg;
    cursor:                      "pointer";
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @main-fg;
}

element selected.normal {
    background-color:            @select-bg;
    border-color:                @main-br;
    text-color:                  @select-fg;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        64px;
    cursor:                      inherit;
    horizontal-align:            0.5;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
