{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "Debian"
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "command",
      "key": "  ",
      "keyColor": "38;2;122;162;247",
      "text": "splash=$(hyprctl splash 2>/dev/null); echo ${splash:-Bienvenido}"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐"
    },
    {
      "type": "chassis",
      "key": "  󰇺 Chassis",
      "format": "{1} {2} {3}"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "format": "{2}",
      "keyColor": "38;2;247;118;142"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "format": "{2}",
      "keyColor": "38;2;247;118;142"
    },
    {
      "type": "packages",
      "key": "  󰏗 Packages",
      "keyColor": "38;2;158;206;106"
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "format": "{1}x{2} @ {3}Hz [{7}]",
      "keyColor": "38;2;158;206;106"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "38;2;224;175;104"
    },
    {
      "type": "wm",
      "key": "  󱗃 WM",
      "format": "{2}",
      "keyColor": "38;2;224;175;104"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "title",
      "key": "  ",
      "format": "{6} {7} {8}"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐"
    },
    {
      "type": "cpu",
      "format": "{1} @ {7}",
      "key": "   CPU",
      "keyColor": "38;2;122;162;247"
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": "  󰊴 GPU",
      "keyColor": "38;2;122;162;247"
    },
    {
      "type": "gpu",
      "format": "{3}",
      "key": "   GPU Driver",
      "keyColor": "38;2;187;154;247"
    },
    {
      "type": "memory",
      "key": "   Memory",
      "keyColor": "38;2;187;154;247"
    },
    {
      "type": "disk",
      "key": "  󱦟 OS Age",
      "folders": "/",
      "keyColor": "38;2;247;118;142",
      "format": "{days} days"
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime",
      "keyColor": "38;2;247;118;142"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
