{
    "label": "lock",
    "action": "hyprlock",
    "text": "Bloquear",
    "keybind": "l"
}

{
    "label": "logout",
    "action": "hyprctl dispatch exit",
    "text": "Cerrar sesión",
    "keybind": "e"
}

{
    "label": "suspend",
    "action": "hyprlock & disown && systemctl suspend",
    "text": "Suspender",
    "keybind": "u"
}

{
    "label": "shutdown",
    "action": "systemctl poweroff --no-wall",
    "text": "Apagar",
    "keybind": "s"
}

{
    "label": "hibernate",
    "action": "systemctl hibernate",
    "text": "Hibernar",
    "keybind": "h"
}

{
    "label": "reboot",
    "action": "systemctl reboot --no-wall",
    "text": "Reiniciar",
    "keybind": "r"
}
