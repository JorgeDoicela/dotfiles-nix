{
    "include": ["~/.config/waybar/modules.json"],
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "mpris",
        "cpu",
        "memory",
        "network",
        "bluetooth",
        "custom/notification",
        "pulseaudio",
        "battery",
        "custom/session"
    ],
    "hyprland/workspaces": {
        "all-outputs": true
    }
}
