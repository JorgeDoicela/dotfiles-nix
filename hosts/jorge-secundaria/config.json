[
    {
        "include": ["~/.config/waybar/modules.json"],
        "output": ["HDMI-A-1", "DP-1"],
        "layer": "top",
        "position": "top",
        "height": 26,
        "spacing": 4,
        "margin-top": 0,
        "margin-left": 0,
        "margin-right": 0,
        "modules-left": [
            "custom/launcher",
            "hyprland/workspaces",
            "hyprland/window"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "mpris",
            "cpu",
            "memory",
            "network",
            "bluetooth",
            "custom/notification",
            "pulseaudio",
            "battery",
            "custom/session"
        ],
        "hyprland/workspaces": {
            "all-outputs": false
        }
    },
    {
        "include": ["~/.config/waybar/modules.json"],
        "output": ["eDP-1"],
        "layer": "top",
        "position": "top",
        "height": 26,
        "spacing": 4,
        "margin-top": 0,
        "margin-left": 0,
        "margin-right": 0,
        "modules-left": [
            "custom/launcher",
            "hyprland/workspaces",
            "hyprland/window"
        ],
        "modules-center": [
            "mpris"
        ],
        "modules-right": [
            "pulseaudio",
            "battery",
            "custom/notification",
            "clock#compact",
            "custom/session"
        ],
        "hyprland/workspaces": {
            "all-outputs": false
        }
    }
]
